meta {
  name: 01-204-clear-monthly-returns
  type: http
  seq: 1
}

post {
  url: {{submissionBaseUrl}}{{submissionServicePath}}/test-only/monthly-returns/cleanup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "zReferences": [
      "{{zReference}}",
      "{{nilZReference}}",
      "{{missingZReference}}",
      "{{declarationZReference}}",
      "{{declarationMissingZReference}}",
      "{{submissionDeclaredZReference}}",
      "{{outsidePeriodZReference}}",
      "{{deleteZReference}}",
      "{{callbackZReference}}"
    ]
  }
}

assert {
  res.status: eq 204
}

script:pre-request {
  const zReferences = req.getBody().zReferences.map(reference => bru.interpolate(reference));
  const url = `${bru.getEnvVar("baseUrl")}${bru.getEnvVar("servicePath")}/test-only/monthly-returns/cleanup`;
  const response = await bru.sendRequest({
    method: "POST",
    url,
    headers: { "Content-Type": "application/json" },
    data: { zReferences },
    timeout: 3000
  });
  if (response.status !== 204) {
    throw new Error(`Expected backend monthly returns cleanup to respond with 204, got ${response.status}. URL: ${url}`);
  }
}
