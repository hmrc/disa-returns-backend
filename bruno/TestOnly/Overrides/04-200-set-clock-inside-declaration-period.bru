meta {
  name: 04-200-set-clock-inside-declaration-period
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}{{servicePath}}/test-only/overrides/{{zReference}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "clock": { "date": "{{declarationPeriodDate}}" },
    "reportingWindow": null
  }
}

assert {
  res.status: eq 200
  res.body.clock.date: eq {{declarationPeriodDate}}
  res.body.reportingWindow: isNull
}

script:pre-request {
  const zReferenceVariableNames = bru.getVar("runValidationHelpers") === "true"
    ? ["callbackZReference"]
    : [
        "zReference",
        "nilZReference",
        "missingZReference",
        "declarationZReference",
        "declarationMissingZReference",
        "submissionDeclaredZReference",
        "outsidePeriodZReference",
        "deleteZReference",
        "callbackZReference"
      ];
  const body = {
    clock: { date: bru.getEnvVar("declarationPeriodDate") },
    reportingWindow: null
  };

  for (const variableName of zReferenceVariableNames) {
    const zReference = bru.getVar(variableName) || bru.getEnvVar(variableName);
    const url = `${bru.getEnvVar("baseUrl")}${bru.getEnvVar("servicePath")}/test-only/overrides/${zReference}`;
    let response;

    try {
      response = await bru.sendRequest({
        method: "PUT",
        url,
        headers: { "Content-Type": "application/json" },
        data: body,
        timeout: 3000
      });
    } catch (error) {
      response = error.response;
    }

    if (!response || response.status !== 200) {
      throw new Error(`Expected backend override setup for ${zReference} to respond with 200, got ${response?.status ?? "no response"}. URL: ${url}`);
    }
  }
}
