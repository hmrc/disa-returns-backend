meta {
  name: 02-200-set-clock-outside-declaration-period
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}{{servicePath}}/test-only/overrides/{{zReference}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "clock": { "date": "{{outsideDeclarationPeriodDate}}" },
    "reportingWindow": null
  }
}

assert {
  res.status: eq 200
  res.body.clock.date: eq {{outsideDeclarationPeriodDate}}
  res.body.reportingWindow: isNull
}
